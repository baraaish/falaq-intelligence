PORT=3000
HOST=127.0.0.1

# Add one or more keys. The backend tries them in this order.
GROQ_API_KEY=
CEREBRAS_API_KEY=
OPENROUTER_API_KEY=
GITHUB_MODELS_TOKEN=

# Optional model overrides.
GROQ_MODEL=llama-3.3-70b-versatile
CEREBRAS_MODEL=gpt-oss-120b
OPENROUTER_MODEL=openai/gpt-oss-20b:free
GITHUB_MODELS_MODEL=openai/gpt-4.1-mini

# Add this after deploying google-apps-script.js from your Google Sheet.
GOOGLE_SHEETS_URL=

# Edge is auto-detected on Windows. Set this only when deploying elsewhere.
BROWSER_EXECUTABLE_PATH=
