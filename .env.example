PORT=3000
HOST=127.0.0.1

# Add one or more keys. The backend tries them in this order and falls
# through to the next provider on any failure, including quota exhaustion.
CEREBRAS_API_KEY=
GROQ_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=

# Optional model overrides.
CEREBRAS_MODEL=gpt-oss-120b
GROQ_MODEL=llama-3.3-70b-versatile
GEMINI_MODEL=gemini-3.6-flash
OPENROUTER_MODEL=openai/gpt-oss-20b:free

# Add this after deploying google-apps-script.js from your Google Sheet.
GOOGLE_SHEETS_URL=

# Transactional email through Resend.
RESEND_API_KEY=
EMAIL_FROM=Falaq Bot <bot@mail.falaqai.com>
EMAIL_REPLY_TO=hello@falaqai.com
LEAD_NOTIFICATION_EMAIL=hello@falaqai.com

# Edge is auto-detected on Windows. Set this only when deploying elsewhere.
BROWSER_EXECUTABLE_PATH=
